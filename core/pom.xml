<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>de.schosin.ecs</groupId>
        <artifactId>ecs-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    
    <artifactId>ecs-core</artifactId>

    <dependencies>
        <dependency>
            <groupId>de.schosin.ecs</groupId>
            <artifactId>ecs-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>de.schosin.ecs</groupId>
            <artifactId>ecs-utils</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>de.schosin.ecs.storage</groupId>
            <artifactId>ecs-storage-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>de.schosin.ecs.buildtools</groupId>
            <artifactId>ecs-build-tools-codegen-apt</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
            
        <dependency>
          <groupId>net.bytebuddy</groupId>
          <artifactId>byte-buddy</artifactId>
        </dependency>
        <dependency>
          <groupId>tech.hiddenproject</groupId>
          <artifactId>aide-reflection</artifactId>
        </dependency>
    
        <dependency>
            <groupId>${storage.impl.groupId}</groupId>
            <artifactId>${storage.impl.artifactId}</artifactId>
            <version>${storage.impl.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
    
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <annotationProcessorPaths>
                                <annotationProcessorPath>
                                    <groupId>de.schosin.ecs.buildtools</groupId>
                                    <artifactId>ecs-build-tools-codegen-apt</artifactId>
                                    <version>${project.version}</version>
                                </annotationProcessorPath>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>